// Pulled from the database built by prisma/migrations (FND-04). Migrations are hand-written from the
// reviewed DDL in docs/architecture/sql/; never let `prisma migrate dev` invent one. Models mirror table
// names (snake_case). CI runs `pnpm prisma:drift` to prove this file matches the migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_log {
  id          BigInt    @id @default(autoincrement())
  wedding_id  String?   @db.Uuid
  actor_type  String
  actor_id    String?   @db.Uuid
  action      String
  entity_type String
  entity_id   String?   @db.Uuid
  before      Json?
  after       Json?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  weddings    weddings? @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([wedding_id, created_at(sort: Desc)], map: "audit_wedding_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model consents {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wedding_id     String    @db.Uuid
  guest_id       String    @db.Uuid
  purpose        String
  notice_version String
  granted_at     DateTime  @default(now()) @db.Timestamptz(6)
  withdrawn_at   DateTime? @db.Timestamptz(6)
  guests         guests    @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  weddings       weddings  @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([guest_id, purpose], map: "consents_guest_idx")
}

model event_groups {
  event_id     String       @db.Uuid
  group_id     String       @db.Uuid
  events       events       @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guest_groups guest_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([event_id, group_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model events {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wedding_id   String         @db.Uuid
  venue_id     String?        @db.Uuid
  kind         String         @default("custom")
  name         String
  starts_at    DateTime       @db.Timestamptz(6)
  ends_at      DateTime?      @db.Timestamptz(6)
  dress_code   String?
  notes        String?
  sort_order   Int            @default(0)
  visibility   String         @default("all")
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  event_groups event_groups[]
  venues       venues?        @relation(fields: [venue_id], references: [id], onUpdate: NoAction)
  weddings     weddings       @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([wedding_id, starts_at], map: "events_wedding_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model guest_groups {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wedding_id   String         @db.Uuid
  name         String
  system_key   String?
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  event_groups event_groups[]
  weddings     weddings       @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  party_groups party_groups[]

  @@unique([wedding_id, name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model guests {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wedding_id     String           @db.Uuid
  party_id       String           @db.Uuid
  is_primary     Boolean          @default(false)
  full_name      String
  phone_e164     String?
  email          String?          @db.Citext
  age_band       String?
  is_plus_one    Boolean          @default(false)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?        @db.Timestamptz(6)
  consents       consents[]
  parties        parties          @relation(fields: [party_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  weddings       weddings         @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  media_objects  media_objects[]
  push_devices   push_devices[]
  refresh_tokens refresh_tokens[]

  @@index([full_name(ops: raw("gin_trgm_ops"))], map: "guests_name_trgm_idx", type: Gin)
  @@index([party_id], map: "guests_party_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model idempotency_keys {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope           String
  idem_key        String
  wedding_id      String?   @db.Uuid
  method          String
  route           String
  request_hash    Bytes
  state           String    @default("in_progress")
  response_status Int?
  response_body   Json?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  expires_at      DateTime  @default(dbgenerated("(now() + '24:00:00'::interval)")) @db.Timestamptz(6)
  weddings        weddings? @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([scope, idem_key])
  @@index([expires_at], map: "idempotency_keys_expires_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model media_objects {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wedding_id           String    @db.Uuid
  kind                 String
  s3_bucket            String
  s3_key               String    @unique
  content_type         String
  byte_size            BigInt?
  sha256               Bytes?
  status               String    @default("pending")
  uploaded_by_guest_id String?   @db.Uuid
  uploaded_by_user_id  String?   @db.Uuid
  delete_after         DateTime? @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  guests               guests?   @relation(fields: [uploaded_by_guest_id], references: [id], onUpdate: NoAction)
  users                users?    @relation(fields: [uploaded_by_user_id], references: [id], onUpdate: NoAction)
  weddings             weddings  @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([wedding_id, kind, created_at(sort: Desc)], map: "media_wedding_kind_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model organization_members {
  organization_id String        @db.Uuid
  user_id         String        @db.Uuid
  org_role        String
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([organization_id, user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model organizations {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  kind                 String
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  organization_members organization_members[]
  weddings             weddings[]
}

model parties {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wedding_id         String         @db.Uuid
  label              String
  link_token_hash    Bytes?         @unique
  link_rotated_at    DateTime?      @db.Timestamptz(6)
  plus_ones_allowed  Int            @default(0)
  is_outstation      Boolean        @default(false)
  preferred_language String         @default("en")
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?      @db.Timestamptz(6)
  guests             guests[]
  weddings           weddings       @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  party_groups       party_groups[]
}

model party_groups {
  party_id     String       @db.Uuid
  group_id     String       @db.Uuid
  guest_groups guest_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parties      parties      @relation(fields: [party_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([party_id, group_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model push_devices {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?  @db.Uuid
  guest_id     String?  @db.Uuid
  platform     String
  fcm_token    String   @unique
  app_version  String?
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  guests       guests?  @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model realtime_events {
  id         BigInt   @id @default(autoincrement())
  wedding_id String   @db.Uuid
  channel    String
  kind       String
  payload    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  weddings   weddings @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "realtime_events_created_idx", type: Brin)
  @@index([wedding_id, channel, id], map: "realtime_events_replay_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model refresh_tokens {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  audience       String
  user_id        String?   @db.Uuid
  guest_id       String?   @db.Uuid
  wedding_id     String?   @db.Uuid
  device_id      String
  family_id      String    @db.Uuid
  token_hash     Bytes     @unique
  expires_at     DateTime  @db.Timestamptz(6)
  revoked_at     DateTime? @db.Timestamptz(6)
  revoked_reason String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  guests         guests?   @relation(fields: [guest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  weddings       weddings? @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "refresh_tokens_expires_idx")
  @@index([family_id], map: "refresh_tokens_family_idx")
}

model users {
  id                                                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  google_sub                                        String                 @unique
  email                                             String                 @unique @db.Citext
  name                                              String?
  phone_e164                                        String?
  avatar_url                                        String?
  created_at                                        DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                                        DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at                                        DateTime?              @db.Timestamptz(6)
  last_sign_in_at                                   DateTime?              @db.Timestamptz(6)
  media_objects                                     media_objects[]
  organization_members                              organization_members[]
  push_devices                                      push_devices[]
  refresh_tokens                                    refresh_tokens[]
  wedding_members_wedding_members_invited_byTousers wedding_members[]      @relation("wedding_members_invited_byTousers")
  wedding_members_wedding_members_user_idTousers    wedding_members[]      @relation("wedding_members_user_idTousers")
  weddings                                          weddings[]
}

model venues {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wedding_id String   @db.Uuid
  name       String
  address    String?
  lat        Float?
  lng        Float?
  maps_url   String?
  notes      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  events     events[]
  weddings   weddings @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([wedding_id], map: "venues_wedding_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model wedding_members {
  wedding_id                              String   @db.Uuid
  user_id                                 String   @db.Uuid
  role                                    String
  invited_by                              String?  @db.Uuid
  created_at                              DateTime @default(now()) @db.Timestamptz(6)
  users_wedding_members_invited_byTousers users?   @relation("wedding_members_invited_byTousers", fields: [invited_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_wedding_members_user_idTousers    users    @relation("wedding_members_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  weddings                                weddings @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([wedding_id, user_id])
  @@index([user_id], map: "wedding_members_user_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model weddings {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String             @db.Uuid
  title            String
  timezone         String             @default("Asia/Kolkata")
  starts_on        DateTime           @db.Date
  ends_on          DateTime           @db.Date
  plan             String             @default("free")
  status           String             @default("draft")
  settings         Json               @default("{}")
  created_by       String             @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  audit_log        audit_log[]
  consents         consents[]
  events           events[]
  guest_groups     guest_groups[]
  guests           guests[]
  idempotency_keys idempotency_keys[]
  media_objects    media_objects[]
  parties          parties[]
  realtime_events  realtime_events[]
  refresh_tokens   refresh_tokens[]
  venues           venues[]
  wedding_members  wedding_members[]
  users            users              @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations    organizations      @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
