  privacy_notices                              privacy_notices @relation(fields: [notice_version], references: [version], onDelete: NoAction, onUpdate: NoAction, map: "consents_notice_fk")
  guests_consents_recorded_by_guest_idToguests guests?         @relation("consents_recorded_by_guest_idToguests", fields: [recorded_by_guest_id], references: [id], onUpdate: NoAction)
