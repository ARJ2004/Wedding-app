// Pulled from the database built by prisma/migrations. Migrations are hand-written from the reviewed
// DDL in docs/architecture/sql/; never let `prisma migrate dev` invent one. Models mirror table names
// (snake_case). Views (party_invited_events) are queried with $queryRaw. CI runs `pnpm prisma:drift`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_log {
  id              BigInt         @id @default(autoincrement())
  wedding_id      String?        @db.Uuid
  actor_type      String
  actor_id        String?        @db.Uuid
  action          String
  entity_type     String
  entity_id       String?        @db.Uuid
  before          Json?
  after           Json?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  organization_id String?        @db.Uuid
  actor_role      String?
  actor_label     String?
  request_id      String?
  redacted_at     DateTime?      @db.Timestamptz(6)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  weddings        weddings?      @relation(fields: [wedding_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([wedding_id, created_at(sort: Desc)], map: "audit_wedding_idx")
  @@index([wedding_id, action, id(sort: Desc)], map: "audit_wedding_action_idx")
  @@index([wedding_id, actor_id, id(sort: Desc)], map: "audit_wedding_actor_idx")
  @@index([wedding_id, entity_type, entity_id, id(sort: Desc)], map: "audit_wedding_entity_idx")
  @@index([wedding_id, id(sort: Desc)], map: "audit_wedding_id_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model consents {
  id                                           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
