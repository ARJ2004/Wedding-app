# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://mehfil:mehfil@localhost:5432/mehfil_dev

# Host/guest access-token secrets: 32+ random bytes each (openssl rand -hex 32)
JWT_HOST_SECRET=dev-only-host-secret-change-me-0123456789abcdef
JWT_GUEST_SECRET=dev-only-guest-secret-change-me-0123456789abcdef

# Dev bypass: accepts "dev:<email>" as a Google token and OTP 000000. Refused in production.
DEV_AUTH_ENABLED=true

# s3 | minio | fake   (fake is in-memory, tests only)
OBJECT_STORE=minio
S3_BUCKET=mehfil-dev
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=mehfil
S3_SECRET_ACCESS_KEY=mehfil-dev-secret

# meta | log   (log writes outbound messages to the console/DB instead of sending)
MESSAGING_PROVIDER=log

# Swagger UI at /v1/docs and spec at /v1/openapi.json (never in production)
OPENAPI_DOCS=true

# Required in production
GOOGLE_WEB_CLIENT_ID=
SENTRY_DSN=
