{
  "name": "mehfil",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.11" },
  "scripts": {
    "dev": "pnpm --filter @mehfil/api run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r --parallel run lint",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @mehfil/api run test:e2e",
    "format": "prettier --write .",
    "api-client:generate": "pnpm --filter @mehfil/api run openapi:emit && pnpm --filter @mehfil/api-client run generate"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
